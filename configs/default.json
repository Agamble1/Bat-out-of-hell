{
  "scanner": {
    "timeout": 5,
    "max_threads": 10,
    "user_agent": "BAT-Scanner/1.0"
  },
  "port_scanner": {
    "timeout": 1,
    "ports": [21, 22, 23, 25, 53, 80, 443, 445, 3306, 3389, 5432, 8080, 8443]
  },
  "logging": {
    "level": "INFO",
    "file": "logs/bat_scanner.log"
  },
  "reports": {
    "output_dir": "reports",
    "format": "json"
  }
}
